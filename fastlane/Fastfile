# Store lanes for Antiphon, mirroring the OBS Blade store interaction.
# Credentials are read by path from the environment and never stored here:
#   ANTIPHON_ASC_KEY_PATH, ANTIPHON_ASC_KEY_ID, ANTIPHON_ASC_ISSUER_ID
# (falls back to the maintainer's OBS_BLADE_ASC_* equivalents — same team).

opt_out_usage
default_platform(:ios)

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ANTIPHON_ASC_KEY_ID", ENV.fetch("ASC_API_KEY_ID", ENV.fetch("OBS_BLADE_ASC_KEY_ID"))),
    issuer_id: ENV.fetch("ANTIPHON_ASC_ISSUER_ID", ENV.fetch("ASC_API_ISSUER_ID", ENV.fetch("OBS_BLADE_ASC_ISSUER_ID"))),
    key_filepath: ENV.fetch("ANTIPHON_ASC_KEY_PATH", ENV.fetch("ASC_API_KEY_PATH", ENV.fetch("OBS_BLADE_ASC_KEY_PATH"))),
  )
end

platform :ios do
  desc "Upload an .ipa to TestFlight (internal testers only)"
  lane :beta do |options|
    pilot(
      api_key: asc_api_key,
      ipa: options.fetch(:ipa),
      changelog: File.read("testflight_notes.txt"),
      distribute_external: false,
      skip_waiting_for_build_processing: false,
    )
  end
end
